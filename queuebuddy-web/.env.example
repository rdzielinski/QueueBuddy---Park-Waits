# Copy to `.env.local` for local Vite dev.

# Where the frontend sends API calls. In production leave this unset — the app
# defaults to same-origin "/api", served by the Pages Functions in functions/.
# VITE_API_BASE=/api

# Optional: proxy /api/* from the Vite dev server to a deployed API (e.g. your
# Cloudflare Pages preview URL), so `npm run dev` shows live data without
# running Functions locally. Alternatively use `npm run pages:dev`.
# VITE_API_PROXY=https://queuebuddy-web.pages.dev
